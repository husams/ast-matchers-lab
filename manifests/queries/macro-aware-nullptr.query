# macro-aware-nullptr.query — use-nullptr, but skip hits generated by the CHECK macro
# and anything outside the main file (headers), like a real clang-tidy check would.
# Run:  $LLVM/bin/clang-query -f manifests/queries/macro-aware-nullptr.query manifests/capstone.cpp -- -std=c++23
set output diag

let nullConst implicitCastExpr(hasCastKind("CK_NullToPointer"),
                               hasSourceExpression(unless(cxxNullPtrLiteralExpr())))
let fixable allOf(unless(isExpandedFromMacro("CHECK")), isExpansionInMainFile())

match implicitCastExpr(nullConst, fixable).bind("null")
