    },
    "matcher-traversal": {
      "captures": {
        "1": {
          "name": "support.function.matcher.traversal.astmatcher"
        }
      },
      "match": "\\b(ignoringElidableConstructorCall|forEachConstructorInitializer|hasConditionVariableStatement|forEachArgumentWithParamType|hasAnyConstructorInitializer|hasUnqualifiedDesugaredType|hasImplicitDestinationType|hasAnyTemplateArgumentLoc|forEachArgumentWithParam|onImplicitObjectArgument|forEachTemplateArgument|hasAnyTemplateArgument|hasSpecializedTemplate|hasTemplateArgumentLoc|hasAnyUsingShadowDecl|hasInClassInitializer|ignoringParenImpCasts|forEachLambdaCapture|hasExplicitSpecifier|refersToIntegralType|containsDeclaration|hasObjectExpression|hasSourceExpression|hasTemplateArgument|refersToDeclaration|hasAnyPlacementArg|hasAnySubstatement|hasDestinationType|hasFalseExpression|hasReplacementType|hasStructuredBlock|ignoringParenCasts|specifiesNamespace|forEachDescendant|forEachOverridden|forEachSwitchCase|hasAnyDeclaration|hasArgumentOfType|hasTrueExpression|hasUnderlyingDecl|hasUnderlyingType|hasUnqualifiedLoc|forDecomposition|hasCanonicalType|hasEitherOperand|hasInitStatement|hasReturnTypeLoc|hasSyntacticForm|ignoringImpCasts|ignoringImplicit|refersToTemplate|specifiesTypeLoc|throughUsingDecl|binaryOperation|hasAnyParameter|hasCaseConstant|hasLoopVariable|hasPlacementArg|hasReceiverType|hasUnaryOperand|thisPointerType|withInitializer|hasAnyArgument|hasDecayedType|hasDeclContext|hasDeclaration|hasDeducedType|hasElementType|hasInitializer|hasReferentLoc|hasReturnValue|ignoringParens|hasAnyBinding|hasAnyCapture|hasDescendant|hasDirectBase|hasPointeeLoc|hasSingleDecl|hasTargetDecl|specifiesType|hasAnyClause|hasArraySize|hasCondition|hasIncrement|hasParameter|hasQualifier|hasRangeInit|hasValueType|refersToType|alignOfExpr|capturesVar|forCallable|forFunction|hasAncestor|hasArgument|hasFoldInit|hasLoopInit|hasOperands|hasReceiver|hasSizeExpr|hasAnyBase|hasAnyBody|hasBinding|hasPattern|hasTypeLoc|invocation|optionally|references|sizeOfExpr|hasMethod|hasParent|hasPrefix|innerType|forField|hasIndex|pointsTo|traverse|findAll|forEach|hasBase|hasBody|hasElse|hasIni