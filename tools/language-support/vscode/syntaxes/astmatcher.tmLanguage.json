{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "fileTypes": [
    "query"
  ],
  "name": "AST Matcher DSL",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#command"
    },
    {
      "include": "#setting"
    },
    {
      "include": "#bind"
    },
    {
      "include": "#matcher-node"
    },
    {
      "include": "#matcher-narrowing"
    },
    {
      "include": "#matcher-traversal"
    },
    {
      "include": "#matcher-unknown"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#boolean"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "bind": {
      "begin": "\\.\\s*(bind)\\s*\\(",
      "beginCaptures": {
        "1": {
          "name": "support.function.bind.astmatcher"
        }
      },
      "end": "\\)",
      "patterns": [
        {
          "include": "#bind-id"
        }
      ]
    },
    "bind-id": {
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.astmatcher"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.astmatcher"
        }
      },
      "name": "entity.name.tag.bind-id.astmatcher"
    },
    "boolean": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.astmatcher"
    },
    "command": {
      "captures": {
        "1": {
          "name": "keyword.control.astmatcher"
        }
      },
      "match": "^\\s*\\b(disable|enable|match|help|quit|let|set|l|m|q)\\b"
    },
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.astmatcher"
    },
    "matcher-narrowing": {
      "captures": {
        "1": {
          "name": "support.function.matcher.narrowing.astmatcher"
        }
      },
      "match": "\\b(isExplicitTemplateSpecialization|isExplicitObjectMemberFunction|declaresSameEntityAsBoundNode|hasAnyOverloadedOperatorName|isAllowedToContainClauseKind|memberHasSameNameAsBoundNode|hasAutomaticStorageDuration|requiresZeroInitialization|templateArgumentLocCountIs|hasOverloadedOperatorName|isExpansionInFileMatching|isExpansionInSystemHeader|isInTemplateInstantiation|hasExternalFormalLinkage|hasStaticStorageDuration|hasThreadStorageDuration|isCopyAssignmentOperator|isInstantiationDependent|isMoveAssignmentOperator|hasDynamicExceptionSpec|isDelegatingConstructor|isInheritingConstructor|isTemplateInstantiation|templateArgumentCountIs|isInAnonymousNamespace|isDirectlyDerivedFrom|isExpansionInMainFile|isStandaloneDirective|realFloatingPointType|argumentCountAtLeast|isAssignmentOperator|isComparisonOperator|isDefaultConstructor|isListInitialization|isStaticStorageClass|equalsIntegralValue|isExceptionVariable|isExpandedFromMacro|isMemberInitializer|isSameOrDerivedFrom|isVolatileQualified|nullPointerConstant|hasAnyOperatorName|hasDefaultArgument|hasKeywordSelector|hasLocalQualifiers|isFirstPrivateKind|isVirtualAsWritten|designatorCountIs|hasTrailingReturn|isBaseInitializer|isCopyConstructor|isInstanceMessage|isMoveConstructor|isUnsignedInteger|hasDependentName|hasGlobalStorage|hasUnarySelector|isConstQualified|isInStdNamespace|isInstanceMethod|isValueDependent|parameterCountIs|statementCountIs|argumentCountIs|equalsBoundNode|hasLocalStorage|hasNullSelector|hasOperatorName|isSignedInteger|isTypeDependent|matchesSelector|numSelectorArgs|hasAnySelector|isAnyCharacter|isClassMessage|isInstantiated|isUserProvided|hasDefinition|hasMemberName|isClassMethod|isDerivedFrom|isInitCapture|isPrivateKind|isStaticLocal|capturesThis|isAnyPointer|isAtPosition|isBinaryFold|isDefinition|isSharedKind|booleanType|declCountIs|hasBitWidth|hasCastKind|hasSelector|isAnonymous|isConsteval|isConstexpr|isConstinit|isDefaulted|isProtected|isRightFold|isUnaryFold|matchesName|equalsNode|hasAnyName|isBitField|isCatchAll|isExplicit|isImplicit|isIntegral|isLeftFold|isNoReturn|isNoneKind|isOverride|isVariadic|isDeleted|isExternC|isInteger|isNoThrow|isPrivate|isVirtual|isWritten|anything|asString|isInline|isLambda|isPublic|isScoped|isStruct|mapAnyOf|voidType|hasAttr|hasName|hasSize|isArray|isArrow|isClass|isConst|isFinal|isUnion|usesADL|equals|isEnum|isMain|isPure|isWeak|ofKind|unless|allOf|anyOf)\\b(?=\\s*\\()"
