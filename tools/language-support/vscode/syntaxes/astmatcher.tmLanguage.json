    "matcher-node": {
      "captures": {
        "1": {
          "name": "support.class.matcher.node.astmatcher"
        }
      },
      "match": "\\b(classTemplatePartialSpecializationDecl|deducedTemplateSpecializationType|classTemplateSpecializationDecl|templateSpecializationTypeLoc|substNonTypeTemplateParmExpr|cxxDependentScopeMemberExpr|dependentSizedExtVectorType|unresolvedUsingTypenameDecl|cxxRewrittenBinaryOperator|cxxUnresolvedConstructExpr|templateSpecializationType|binaryConditionalOperator|cxxStdInitializerListExpr|dependentScopeDeclRefExpr|substTemplateTypeParmType|materializeTemporaryExpr|ompTargetUpdateDirective|templateTemplateParmDecl|unaryExprOrTypeTraitExpr|unresolvedUsingValueDecl|dependentSizedArrayType|nonTypeTemplateParmDecl|cxxReinterpretCastExpr|cxxTemporaryObjectExpr|nestedNameSpecifierLoc|objcImplementationDecl|ompExecutableDirective|cxxDeductionGuideDecl|cxxFunctionalCastExpr|cxxNullPtrLiteralExpr|implicitValueInitExpr|injectedClassNameType|objcObjectPointerType|typeAliasTemplateDecl|cxxBindTemporaryExpr|dependentCoawaitExpr|functionTemplateDecl|genericSelectionExpr|objcCategoryImplDecl|requiresExprBodyDecl|templateTypeParmDecl|templateTypeParmType|unresolvedLookupExpr|unresolvedMemberExpr|autoreleasePoolStmt|compoundLiteralExpr|conditionalOperator|cxxOperatorCallExpr|incompleteArrayType|lValueReferenceType|nestedNameSpecifier|rValueReferenceType|templateArgumentLoc|translationUnitDecl|arrayInitIndexExpr|arraySubscriptExpr|cudaKernelCallExpr|cxxConstructorDecl|cxxCtorInitializer|cxxDynamicCastExpr|designatedInitExpr|macroQualifiedType|namespaceAliasDecl|unaryTransformType|userDefinedLiteral|usingDirectiveDecl|arrayInitLoopExpr|classTemplateDecl|constantArrayType|convertVectorExpr|coroutineBodyStmt|cxxConversionDecl|cxxDefaultArgExpr|cxxDestructorDecl|cxxMemberCallExpr|cxxStaticCastExpr|decompositionDecl|dependentNameType|fixedPointLiteral|functionProtoType|indirectFieldDecl|memberPointerType|objcInterfaceDecl|objcStringLiteral|ompSplitDirective|variableArrayType|blockPointerType|characterLiteral|cxxBaseSpecifier|cxxConstCastExpr|cxxConstructExpr|cxxNamedCastExpr|enumC