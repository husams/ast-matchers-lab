    "matcher-unknown": {
      "captures": {
        "1": {
          "name": "entity.name.function.astmatcher"
        }
      },
      "match": "\\b([A-Za-z_]\\w*)\\b(?=\\s*\\()"
    },
    "number": {
      "match": "\\b\\d+(\\.\\d+)?\\b",
      "name": "constant.numeric.astmatcher"
    },
    "punctuation": {
